# Shared secrets for the label-ops stack (not committed).
# Prefer editing these in the web UI (http://localhost:8787).

############################  Labeler account (once)  ##################
# Used by: label-watcher, autolabel, graze-post-remover (stream/Ozone)
LABELER_HANDLE=your-labeler.bsky.social
LABELER_DID=did:plc:your-labeler-did
LABELER_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
LABELER_SOCKET_URL=wss://ozone.example.com/xrpc/com.atproto.label.subscribeLabels
OZONE_URL=https://ozone.example.com
WHITELISTED_MODERATORS=did:plc:moderator1

############################  Graze feeds account  #####################
# Usually a different account from the labeler (the one that owns feeds).
# Used by: graze-post-remover — app password is enough (no GRAZE_SESSION_COOKIE)
BSKY_HANDLE=your-feeds-account.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

############################  Config UI  ###############################
CONFIG_UI_PORT=8787
CONFIG_UI_PASSWORD=
LABEL_SYNC_INTERVAL_MINUTES=15
# When 1, saving in the UI recreates running workers so .env/overlays apply
LABEL_OPS_AUTO_RELOAD=1
# Host docker group GID (ls -ln /var/run/docker.sock) if auto-reload fails with permission denied
# DOCKER_GID=996

############################  Settings (Config → Settings)  ############
# Polling
POLLING_SECONDS=30
OZONE_POLLING_SECONDS=30
# label-watcher
BSKY_SERVICE=https://bsky.social
ADMIN_API_KEY=
# shared worker logging
LOG_LEVEL=INFO
# autolabel DM notify (optional)
BSKY_DM_USERNAME=
BSKY_DM_PASSWORD=
MODERATOR_NOTIFICATIONS=
