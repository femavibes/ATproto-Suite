# Zero-Trust Authentication Proxy Configuration
# Supports multiple ModMaster users, each with their own Bluesky account and monitored accounts

# ============================================================================
# USER CONFIGURATION (Numbered Format)
# ============================================================================
# Each user is configured with a number (1, 2, 3, etc.)
# Identifier can be Bluesky handle OR DID (DID recommended - doesn't change)

# ============================================================================
# EXAMPLE 1: Single user with NO monitored accounts
# ============================================================================
USER_1_IDENTIFIER=alice.bsky.social
USER_1_PASSWORD=abcd-efgh-ijkl-mnop

# ============================================================================
# EXAMPLE 2: Single user with monitored accounts
# ============================================================================
# USER_1_IDENTIFIER=bob.bsky.social
# USER_1_PASSWORD=xxxx-xxxx-xxxx-xxxx
# USER_1_MONITORED=bob-alt.bsky.social:yyyy-yyyy-yyyy-yyyy
#
# This means:
# - Main account: bob.bsky.social (password: xxxx-xxxx-xxxx-xxxx)
# - Monitored account: bob-alt.bsky.social (password: yyyy-yyyy-yyyy-yyyy)
# - Each monitored account needs its own Bluesky app password!

# ============================================================================
# EXAMPLE 3: User with multiple monitored accounts
# ============================================================================
# USER_1_IDENTIFIER=charlie.bsky.social
# USER_1_PASSWORD=aaaa-bbbb-cccc-dddd
# USER_1_MONITORED=charlie-work.bsky.social:eeee-ffff-gggg-hhhh,charlie-personal.bsky.social:iiii-jjjj-kkkk-llll,charlie-bot.bsky.social:mmmm-nnnn-oooo-pppp
#
# Format: handle:password,handle:password,handle:password
# Comma-separated list of monitored accounts

# ============================================================================
# EXAMPLE 4: Multiple users on the same proxy
# ============================================================================
# USER_1_IDENTIFIER=alice.bsky.social
# USER_1_PASSWORD=aaaa-aaaa-aaaa-aaaa
# USER_1_MONITORED=alice-alt1.bsky.social:bbbb-bbbb-bbbb-bbbb,alice-alt2.bsky.social:cccc-cccc-cccc-cccc
#
# USER_2_IDENTIFIER=bob.bsky.social
# USER_2_PASSWORD=ffff-ffff-ffff-ffff
# USER_2_MONITORED=bob-alt1.bsky.social:gggg-gggg-gggg-gggg
#
# USER_3_IDENTIFIER=charlie.bsky.social
# USER_3_PASSWORD=kkkk-kkkk-kkkk-kkkk
# (Charlie has no monitored accounts)
#
# IMPORTANT:
# - Each user's monitored accounts are ISOLATED
# - Alice can ONLY access alice-alt1 and alice-alt2
# - Bob can ONLY access bob-alt1
# - When Alice uses autoblock, it only affects HER monitored accounts
# - Bob's and Charlie's accounts are completely unaffected

# ============================================================================
# USING DIDs (RECOMMENDED)
# ============================================================================
# DIDs don't change even if you change your handle
# USER_1_IDENTIFIER=did:plc:abc123xyz
# USER_1_PASSWORD=xxxx-xxxx-xxxx-xxxx
# USER_1_MONITORED=did:plc:def456uvw:yyyy-yyyy-yyyy-yyyy

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port to run the proxy on (default: 3550)
PORT=3550

# API Key (auto-generated on first run, or set your own)
# API_KEY=

# Optional: Set to true to reset the encryption key on startup
# RESET_KEY=false


