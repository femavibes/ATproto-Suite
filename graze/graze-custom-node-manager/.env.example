# Bluesky Credentials
BLUESKY_HANDLE=your.handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# Authentication
# Comma-separated list of Bluesky handles allowed to login
ALLOWED_USERS=fema.monster,trusted.friend.bsky.social
# Comma-separated list of admin users who can push nodes to Graze
ADMIN_USERS=fema.monster
