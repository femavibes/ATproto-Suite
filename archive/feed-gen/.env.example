# Required
PUBLIC_URL=https://123.45.67.89.sslip.io
POSTGRES_PASSWORD=change-me

# Native Postgres on the same host (no Docker): used by scripts/native-*.sh when you `source .env`
# DATABASE_URL=postgresql://feedgen:change-me@127.0.0.1:5432/feedgen
# PORT=8001
# UI_STATIC_ROOT=/absolute/path/to/feed-gen/services/visual-editor/dist

# Optional
ADMIN_EMAIL=you@example.com
OWNER_HANDLE=fema.monster
ALLOWED_HANDLES=fema.monster
HOSTED_MODE=true
LOCAL_BETA_MODE=false

# Recommended (override in production)
SESSION_SECRET=change-me-in-production
FORCE_SECURE_COOKIES=true

# Jetstream ingestion: set in repo-root .env (docker compose reads it) or export before `docker compose up`.
# When true: skips global keyword + English prefilters; only posts matching at least one live feed graph are indexed.
# INGESTION_GRAPH_MATCH=true
# INGESTION_FEED_GRAPH_CACHE_SECONDS=60
