# Environment Configuration - DEVELOPMENT
ENVIRONMENT=dev

# App Configuration
APP_NAME=skymap
BASE_URL=https://skymap.fema.monster
ADMIN_URL=https://skymapadmin.fema.monster

# Bluesky/ATProto
LABELER_DID=did:plc:your-labeler-did
BLUESKY_HANDLE=skymap.fema.monster
BLUESKY_PASSWORD=your-app-password

# Database
DATABASE_URL=postgresql://dev:devpass@localhost:5435/skymap

# Ozone
OZONE_URL=https://ozoneskymap.fema.monster
OZONE_PRIVATE_KEY=your-ozone-private-key
OZONE_ADMIN_PASSWORD=your-ozone-admin-password

# Image Upload
IMGBB_API_KEY=your-imgbb-api-key
